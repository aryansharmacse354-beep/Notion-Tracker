# Notion Tracker Enterprise Configuration

# Webhook Security
WEBHOOK_SECRET=super_secret_enterprise_notion_key_2026
MAX_TIMESTAMP_DRIFT_SECONDS=300

# Notion API Settings
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_TASKS_DB_ID=your_tasks_database_id
NOTION_LOGS_DB_ID=your_run_logs_database_id
NOTION_USERS_DB_ID=your_user_profiles_database_id

# Storage Engine (hybrid | live | mock)
STORAGE_MODE=hybrid

# Token-Bucket Rate Limiter Settings
RATE_LIMIT_CAPACITY=10.0
RATE_LIMIT_REPLENISH_RATE=2.0

# Outbound Notification Channels
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-teams-webhook-url
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notion-tracker@aiexperts.edu
NOTIFICATION_RECIPIENT_EMAIL=ops-team@aiexperts.edu

# Biometric & OTP Security Gate
SMS_OTP_SECRET=enterprise_totp_random_seed_key_99
ADMIN_OVERRIDE_PIN=748291

# Network & Server Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DASHBOARD_PORT=8501
POLL_INTERVAL_SECONDS=3.0
