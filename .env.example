# 1. Notion API Credentials & Auto-Provisioning
# Create an integration at https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_PARENT_PAGE_ID=your_parent_workspace_page_id_here
NOTION_TASKS_DB_ID=your_tasks_database_id_here
NOTION_LOGS_DB_ID=your_run_logs_database_id_here
NOTION_USERS_DB_ID=your_user_profiles_database_id_here

# 2. Multi-Modal AI Engine (Gemini 1.5 Flash STT & LangChain Reasoning)
# Required for native voice memo parsing, audio transcription, and pre-audit analysis
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 3. Storage Engine Strategy
# Modes: "hybrid" (auto-fallbacks to SQLite if Notion offline), "live" (Notion API direct), "mock" (local only)
STORAGE_MODE=hybrid

# 4. Ingestion Webhook & Cryptographic Replay Security
WEBHOOK_SECRET=super_secret_enterprise_notion_key_2026
MAX_TIMESTAMP_DRIFT_SECONDS=300
DEDUP_WINDOW_SECONDS=3600

# 5. Token-Bucket Rate Limiter Settings
RATE_LIMIT_CAPACITY=10.0
RATE_LIMIT_REPLENISH_RATE=2.0

# 6. Outbound Notification Dispatch Channels (Stage 4)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-teams-webhook-url
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=aryansharma10122006@gmail.com
NOTIFICATION_RECIPIENT_EMAIL=aryansharma10122006@gmail.com

# 7. Operator Biometric & OTP Security Gate (IN +91 Standard)
SMS_OTP_SECRET=enterprise_totp_random_seed_key_99
ADMIN_OVERRIDE_PIN=748291
OPERATOR_PHONE_NUMBER=+919876543210

# 8. Background Polling Daemon & Scheduler
POLL_INTERVAL_MINUTES=60
POLL_INTERVAL_SECONDS=3600

# 9. Server & Network Ports
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DASHBOARD_PORT=8501
